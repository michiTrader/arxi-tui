{ "root": { "type": "stack", "children": [
  { "type": "text", "style": {"style": "header"},
    "text": "Δr×i v0.1.0 · dashboard" },

  { "id": "notice", "type": "text", "bind": "host.scene.error",
    "when": "host.scene.error", "style": {"style": "banner"} },

  { "id": "grid", "type": "row", "grow": 1, "when": "ui.max.none", "children": [
    { "type": "stack", "weight": 1, "children": [
      { "id": "pane-chat", "type": "box", "border": "single", "title": "Chat", "grow": 1, "children": [
        { "id": "max-chat", "type": "button", "text": "⤢ max", "on_press": "cmd:/max chat" },
        { "type": "markdown", "bind": "chat.history", "grow": 1 } ] },
      { "id": "pane-todos", "type": "box", "border": "single", "title": "Tasks", "grow": 1, "children": [
        { "id": "max-todos", "type": "button", "text": "⤢ max", "on_press": "cmd:/max todos" },
        { "type": "list", "bind": "agent.todos", "grow": 1,
          "row_template": { "type": "text", "bind": "row.task" } } ] } ] },
    { "type": "stack", "weight": 1, "children": [
      { "id": "pane-team", "type": "box", "border": "single", "title": "Team", "grow": 1, "children": [
        { "id": "max-team", "type": "button", "text": "⤢ max", "on_press": "cmd:/max team" },
        { "type": "list", "bind": "team.members", "grow": 1,
          "row_template": { "type": "text", "bind": "row.id" } } ] },
      { "id": "pane-status", "type": "box", "border": "single", "title": "Status", "grow": 1, "children": [
        { "id": "max-status", "type": "button", "text": "⤢ max", "on_press": "cmd:/max status" },
        { "type": "text", "bind": "model.name" },
        { "type": "text", "bind": "session.tokens_used" },
        { "type": "text", "text": "", "grow": 1 } ] } ] } ] },

  { "id": "full-chat", "type": "box", "border": "single", "title": "Chat (maximized)",
    "when": "ui.max.is.chat", "grow": 1, "children": [
    { "id": "restore-chat", "type": "button", "text": "⤡ restore", "on_press": "cmd:/max" },
    { "type": "markdown", "bind": "chat.history", "grow": 1 } ] },

  { "id": "full-todos", "type": "box", "border": "single", "title": "Tasks (maximized)",
    "when": "ui.max.is.todos", "grow": 1, "children": [
    { "id": "restore-todos", "type": "button", "text": "⤡ restore", "on_press": "cmd:/max" },
    { "type": "list", "bind": "agent.todos", "grow": 1,
      "row_template": { "type": "text", "bind": "row.task" } } ] },

  { "id": "full-team", "type": "box", "border": "single", "title": "Team (maximized)",
    "when": "ui.max.is.team", "grow": 1, "children": [
    { "id": "restore-team", "type": "button", "text": "⤡ restore", "on_press": "cmd:/max" },
    { "type": "list", "bind": "team.members", "grow": 1,
      "row_template": { "type": "text", "bind": "row.id" } } ] },

  { "id": "full-status", "type": "box", "border": "single", "title": "Status (maximized)",
    "when": "ui.max.is.status", "grow": 1, "children": [
    { "id": "restore-status", "type": "button", "text": "⤡ restore", "on_press": "cmd:/max" },
    { "type": "text", "bind": "model.name" },
    { "type": "text", "bind": "session.tokens_used" } ] },

  { "id": "footer", "type": "text", "style": {"style": "dim"},
    "text": "click ⤢ to maximize a pane · ⤡ to restore" }
]}}
