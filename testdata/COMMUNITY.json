{
  "root": {
    "border": "single",
    "children": [
      {
        "bind": "host.scene.error",
        "id": "notice",
        "style": {
          "style": "banner"
        },
        "type": "text",
        "when": "host.scene.error"
      },
      {
        "children": [
          {
            "children": [
              {
                "bind": "community.query",
                "id": "installer.search",
                "placeholder": "search community plugins",
                "type": "input"
              },
              {
                "bind": "community.matches",
                "id": "installer.list",
                "row_template": {
                  "children": [
                    {
                      "children": [
                        {
                          "style": {
                            "style": "header"
                          },
                          "text": "\u003e ",
                          "type": "text",
                          "when": "row.selected"
                        },
                        {
                          "bind": "row.name",
                          "style": {
                            "style": "header"
                          },
                          "type": "text"
                        }
                      ],
                      "type": "row"
                    },
                    {
                      "bind": "row.version",
                      "style": {
                        "style": "dim"
                      },
                      "type": "text"
                    },
                    {
                      "bind": "row.description",
                      "type": "text"
                    }
                  ],
                  "type": "stack"
                },
                "type": "list"
              }
            ],
            "type": "stack",
            "weight": 1
          },
          {
            "children": [
              {
                "children": [
                  {
                    "bind": "community.selected.name",
                    "style": {
                      "style": "header"
                    },
                    "type": "text"
                  },
                  {
                    "bind": "community.selected.version",
                    "style": {
                      "style": "dim"
                    },
                    "type": "text"
                  },
                  {
                    "bind": "community.selected.preview",
                    "type": "markdown"
                  }
                ],
                "type": "stack"
              }
            ],
            "type": "stack",
            "weight": 1
          }
        ],
        "type": "row"
      }
    ],
    "title": "Community — browse and install",
    "type": "box"
  }
}