{
  "id": "sobria-add-model-row",
  "order": "add a row under the input showing which model is answering and how many tokens the session has used",
  "base": "SOBRIA.json",
  "rationale": "The order is underspecified in the way real orders are: it says what to show, not what the field is called. The obvious reading invents 'model.current', which reads exactly like a signed bind and is not one — BINDS.md signs 'model.name'. This is the corpus' base case for the repair loop: the first patch is structurally correct and fails on vocabulary alone, so convergence depends entirely on reading the refusal.",
  "attempts": [
    {
      "note": "structure is right, the bind name is guessed",
      "document": {
        "root": {
          "type": "stack",
          "children": [
            { "id": "chat", "type": "markdown", "bind": "chat.history", "grow": 1 },
            { "id": "prompt", "type": "input", "bind": "user.input", "prefix": "┃ " },
            { "id": "model", "type": "row", "children": [
              { "type": "text", "bind": "model.current" },
              { "type": "text", "text": " \u00b7 ", "style": { "style": "dim" } },
              { "type": "text", "bind": "session.tokens_used", "style": { "style": "dim" } }
            ] }
          ]
        }
      },
      "expect_refused": { "reason": "unsigned bind \"model.current\"", "line": 8 }
    }
  ],
  "convergence": {
    "document": {
      "root": {
        "type": "stack",
        "children": [
          { "id": "chat", "type": "markdown", "bind": "chat.history", "grow": 1 },
          { "id": "prompt", "type": "input", "bind": "user.input", "prefix": "┃ " },
          { "id": "model", "type": "row", "children": [
            { "type": "text", "bind": "model.name" },
            { "type": "text", "text": " \u00b7 ", "style": { "style": "dim" } },
            { "type": "text", "bind": "session.tokens_used", "style": { "style": "dim" } }
          ] }
        ]
      }
    },
    "must_bind": ["model.name", "session.tokens_used"]
  }
}
