{
  "version": 1,
  "bindings": [
    { "key": "ctrl+o", "do": "do:view.expand" },
    { "key": "ctrl+f", "when": "find.open && !screen.open && !approval.pending", "do": "do:find.toggle" },
    { "key": "ctrl+f", "when": "!menu.open && !key.user_bound && !screen.open && !approval.pending", "do": "do:find.toggle" },
    { "key": "enter", "when": "agent.working && !menu.open && !screen.open && !approval.pending && !find.open && !ui.focused && !key.user_bound && !busy.steers", "do": "do:queue.push" },
    { "key": "enter", "when": "agent.working && !menu.open && !screen.open && !approval.pending && !find.open && !ui.focused && !key.user_bound && busy.steers", "do": "do:queue.steer" },
    { "key": "alt+enter", "when": "agent.working && !menu.open && !screen.open && !approval.pending && !find.open && !ui.focused && !key.user_bound && !busy.steers", "do": "do:queue.steer" },
    { "key": "alt+enter", "when": "agent.working && !menu.open && !screen.open && !approval.pending && !find.open && !ui.focused && !key.user_bound && busy.steers", "do": "do:queue.push" },
    { "key": "down", "when": "!menu.open && !screen.open && !approval.pending && !find.open && !key.user_bound && !ui.focused && !arrows.scroll && !history.browsing && input.at_end && shells.count > 0", "do": "focus:shells_chip" },
    { "key": "up", "when": "!menu.open && !screen.open && !approval.pending && !find.open && !key.user_bound && ui.focused", "do": "do:focus.input" }
  ]
}
